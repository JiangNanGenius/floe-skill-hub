{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JiangNanGenius/floe-skill-hub/schema/catalog.schema.json",
  "title": "Floe Skill Hub signed channel feed (catalog.json / android/catalog.json) — schemaVersion 3",
  "description": "Canonical bytes (UTF-8 JSON, sorted keys, \",\"/\":\" separators, no trailing newline) signed Ed25519 over the exact bytes; envelope catalog.sig = {keyID, signature(base64)} identical to the legacy shape. schemaVersion 3 is deliberately outside the old clients' accepted [1,2] so they fail closed; they keep the separately produced legacy 4-item view.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "publisher",
    "channel",
    "feedStatus",
    "hubRepository",
    "sourceCommit",
    "permissionPolicy",
    "entries",
    "counts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "publisher": {
      "const": "JiangNanGenius"
    },
    "channel": {
      "enum": [
        "ios",
        "android"
      ]
    },
    "feedStatus": {
      "enum": [
        "production",
        "fixture"
      ],
      "description": "fixture feeds never activate a production channel and only bind the fixture-only keyID"
    },
    "hubRepository": {
      "const": "JiangNanGenius/floe-skill-hub"
    },
    "sourceCommit": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "required for production: the audited source revision X whose content this feed describes (signed provenance). It is not the revision holding the published bytes: the client resolves the immutable publicationCommit Y externally and fetches feed, signature, reviews and archives at Y. X != Y is normal; a feed never carries the hash of the commit that contains it (no self-reference). Null only in fixture feeds."
    },
    "permissionPolicy": {
      "type": "object",
      "const": {
        "automaticInstallWhenReviewedAndGranted": true,
        "deltaOnlyApproval": true,
        "selfApprovalProhibited": true,
        "userDisabledAndRemovedPriority": "user",
        "temporaryTaskCeiling": "client-enforced"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "planNumber",
          "kind",
          "source",
          "name",
          "description",
          "category",
          "tags",
          "deepAdaptation",
          "upstream",
          "firstParty",
          "runtime",
          "version",
          "minimumAppVersion",
          "status",
          "notes",
          "package",
          "review",
          "installOffer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "planNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 43
          },
          "kind": {
            "enum": [
              "builtin",
              "optional"
            ]
          },
          "source": {
            "enum": [
              "F",
              "A",
              "V",
              "R",
              "K",
              "S",
              "I"
            ]
          },
          "name": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "zh-Hans"
            ],
            "properties": {
              "en": {
                "type": "string"
              },
              "zh-Hans": {
                "type": "string"
              }
            }
          },
          "description": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "zh-Hans"
            ],
            "properties": {
              "en": {
                "type": "string"
              },
              "zh-Hans": {
                "type": "string"
              }
            }
          },
          "category": {
            "enum": [
              "office-documents",
              "writing-communication",
              "web-development",
              "research-data",
              "design-creation",
              "product-requirements",
              "productivity-organization"
            ]
          },
          "tags": {
            "type": "array",
            "minItems": 2,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9.-]*$"
            }
          },
          "deepAdaptation": {
            "type": "boolean"
          },
          "upstream": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repository",
                  "commit",
                  "path",
                  "skillManifestPath",
                  "retrievedAt",
                  "licenseStatus",
                  "licenseEvidencePath",
                  "repositoryLicense",
                  "licenseNote"
                ],
                "properties": {
                  "repository": {
                    "type": "string",
                    "pattern": "^https://github\\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
                  },
                  "commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^[^/][^.]*$"
                  },
                  "skillManifestPath": {
                    "type": "string"
                  },
                  "retrievedAt": {
                    "type": "string",
                    "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
                  },
                  "licenseStatus": {
                    "enum": [
                      "verified",
                      "pending-per-item-audit",
                      "blocked-no-upstream-license"
                    ]
                  },
                  "licenseEvidencePath": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "repositoryLicense": {
                    "type": "string"
                  },
                  "licenseNote": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "en",
                      "zh-Hans"
                    ],
                    "properties": {
                      "en": {
                        "type": "string"
                      },
                      "zh-Hans": {
                        "type": "string"
                      }
                    }
                  }
                },
                "description": "A pin is the review baseline, not a blanket license: verified still requires the per-file audit at packaging; blocked entries can never package."
              },
              {
                "type": "null"
              }
            ]
          },
          "firstParty": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repository",
                  "commit",
                  "path",
                  "skillManifestPath",
                  "retrievedAt",
                  "licenseStatus",
                  "licenseEvidencePath",
                  "releasedVersion",
                  "stagedSourceVersion"
                ],
                "properties": {
                  "repository": {
                    "type": "string"
                  },
                  "commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "path": {
                    "type": "string"
                  },
                  "skillManifestPath": {
                    "type": "string"
                  },
                  "retrievedAt": {
                    "type": "string",
                    "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
                  },
                  "licenseStatus": {
                    "const": "floe-owned"
                  },
                  "licenseEvidencePath": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "releasedVersion": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "stagedSourceVersion": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "description": "First-party pin; released and staged versions are recorded separately (e.g. floe-office released 1.3.0, staged 1.5.0 — never conflated)."
              },
              {
                "type": "null"
              }
            ]
          },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scriptRuntime",
              "capabilities",
              "tools",
              "installPlatforms",
              "pythonPackagesPlan",
              "execution"
            ],
            "properties": {
              "scriptRuntime": {
                "enum": [
                  "none",
                  "javascriptcore",
                  "python.local",
                  "remote"
                ]
              },
              "capabilities": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "workspace.read",
                    "workspace.write",
                    "workspace.delete",
                    "network",
                    "browser.observe",
                    "browser.interact",
                    "credentials",
                    "javascript.local",
                    "python.local",
                    "execution.remote"
                  ]
                }
              },
              "tools": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)+$"
                }
              },
              "installPlatforms": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "ios",
                    "android"
                  ]
                },
                "description": "store channels only (ios|android); the manifest floe.json platforms remain the native enum"
              },
              "pythonPackagesPlan": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "execution": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "os",
                  "arch",
                  "evidence"
                ],
                "properties": {
                  "os": {
                    "enum": [
                      "linux",
                      "macos",
                      "ios",
                      null
                    ]
                  },
                  "arch": {
                    "enum": [
                      "riscv64",
                      "x86_64",
                      "aarch64",
                      "n/a",
                      null
                    ]
                  },
                  "evidence": {
                    "enum": [
                      "unproven",
                      "guest-verified"
                    ]
                  }
                },
                "description": "Execution OS/architecture, separate from store/install channels. unproven is the only value a candidate may carry."
              }
            }
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          },
          "minimumAppVersion": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourcePinned",
              "licenseChecked",
              "adaptation",
              "packaged",
              "reviewed",
              "qualified",
              "published",
              "executionVerified"
            ],
            "properties": {
              "sourcePinned": {
                "type": "boolean"
              },
              "licenseChecked": {
                "type": "boolean"
              },
              "adaptation": {
                "enum": [
                  "awaiting-implementation",
                  "planned",
                  "in-progress",
                  "frozen"
                ]
              },
              "packaged": {
                "type": "boolean"
              },
              "reviewed": {
                "type": "boolean"
              },
              "qualified": {
                "type": "boolean"
              },
              "published": {
                "type": "boolean"
              },
              "executionVerified": {
                "type": "boolean"
              }
            },
            "description": "Distinct lifecycle states. reviewed=>licenseChecked; qualified=>reviewed+packaged; published=>qualified; executionVerified=>frozen adaptation. No state may be inferred from a build."
          },
          "notes": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "zh-Hans"
            ],
            "properties": {
              "en": {
                "type": "string"
              },
              "zh-Hans": {
                "type": "string"
              }
            }
          },
          "package": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "size",
                  "sha256",
                  "contentDigest",
                  "containsScripts"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?:android/)?packages/[a-z][a-z0-9-]*/(?:0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)/[a-z][a-z0-9-]*\\.zip$"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8388608
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "contentDigest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "containsScripts": {
                    "type": "boolean"
                  }
                },
                "description": "contentDigest = SHA256 over sorted big-endian u64-length-prefixed path+bytes of the unpacked files; sha256 = over the exact archive bytes."
              },
              {
                "type": "null"
              }
            ]
          },
          "review": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256",
                  "keyID"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^reviews/.+\\.review\\.json$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "keyID": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "installOffer": {
            "enum": [
              "none",
              "qualified",
              "fixture-simulated"
            ]
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "builtin",
        "optional",
        "deepAdaptation",
        "packaged",
        "reviewed",
        "qualified",
        "offerQualified"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "builtin": {
          "type": "integer",
          "minimum": 0
        },
        "optional": {
          "type": "integer",
          "minimum": 0
        },
        "deepAdaptation": {
          "type": "integer",
          "minimum": 0
        },
        "packaged": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed": {
          "type": "integer",
          "minimum": 0
        },
        "qualified": {
          "type": "integer",
          "minimum": 0
        },
        "offerQualified": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "actual per-feed values recomputed from entries; the store must show qualified/visible counts, never the candidate total"
    },
    "generatedNote": {
      "type": "string"
    }
  }
}
