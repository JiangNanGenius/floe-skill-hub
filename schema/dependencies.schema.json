{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JiangNanGenius/floe-skill-hub/schema/dependencies.schema.json",
  "title": "Floe official Skill dependency declaration v1 (references/dependencies.json — official Skill dependency declaration v1)",
  "description": "Machine-readable mirror of the native strict decoder in FloeAgent/Sources/FloeSkills/SkillDependency.swift (the sole authority), generated from scripts/dependency_declaration.py. The file lives inside the canonical Skill package, so the signed contentDigest covers its bytes and every referenced lock. Declaration is DATA: no URL, command, script, environment, registry, permission or approval field exists. A package carrying this file must raise the entry's minimumAppVersion to at least the first capable build (1.7.60).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Parser compatibility version only; exactly 1. Not the Skill package version (floe.json id/version stays the single package authority)."
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "description": "1-8 profiles; unique ids; automatic provisioning binds to the task's resolved Linux guest environment (no target picker, execution never rerouted).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "requirements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "description": "Unique profile slug (SkillIdentifier grammar)."
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "os",
              "architectures"
            ],
            "properties": {
              "os": {
                "const": "linux"
              },
              "architectures": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "any",
                    "arm64",
                    "riscv64",
                    "x86_64"
                  ]
                }
              }
            }
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "purpose",
                "required"
              ],
              "description": "Tagged requirement entry carrying exactly the key set of its kind; unknown keys (url, command, env, permission, approval, sha256, index, registry, script) fail closed in the native strict decoder, which is the sole authority.",
              "oneOf": [
                {
                  "title": "pip",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "name",
                    "version",
                    "purpose",
                    "required"
                  ],
                  "properties": {
                    "kind": {
                      "const": "pip"
                    },
                    "name": {
                      "$ref": "#/$defs/pipName"
                    },
                    "version": {
                      "$ref": "#/$defs/pipVersion"
                    },
                    "purpose": {
                      "$ref": "#/$defs/purpose"
                    },
                    "required": {
                      "$ref": "#/$defs/required"
                    },
                    "lockfile": {
                      "$ref": "#/$defs/lockfile"
                    }
                  }
                },
                {
                  "title": "apt",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "name",
                    "version",
                    "purpose",
                    "required"
                  ],
                  "properties": {
                    "kind": {
                      "const": "apt"
                    },
                    "name": {
                      "$ref": "#/$defs/aptName"
                    },
                    "version": {
                      "$ref": "#/$defs/aptVersion"
                    },
                    "purpose": {
                      "$ref": "#/$defs/purpose"
                    },
                    "required": {
                      "$ref": "#/$defs/required"
                    }
                  }
                },
                {
                  "title": "npm",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "name",
                    "version",
                    "purpose",
                    "required"
                  ],
                  "properties": {
                    "kind": {
                      "const": "npm"
                    },
                    "name": {
                      "$ref": "#/$defs/npmName"
                    },
                    "version": {
                      "$ref": "#/$defs/npmVersion"
                    },
                    "purpose": {
                      "$ref": "#/$defs/purpose"
                    },
                    "required": {
                      "$ref": "#/$defs/required"
                    }
                  }
                },
                {
                  "title": "font",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "name",
                    "version",
                    "purpose",
                    "required"
                  ],
                  "properties": {
                    "kind": {
                      "const": "font"
                    },
                    "name": {
                      "$ref": "#/$defs/fontIdentity"
                    },
                    "version": {
                      "$ref": "#/$defs/fontVersion"
                    },
                    "purpose": {
                      "$ref": "#/$defs/purpose"
                    },
                    "required": {
                      "$ref": "#/$defs/required"
                    }
                  }
                },
                {
                  "title": "runtimeComponent",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "componentDescriptorPath",
                    "purpose",
                    "required"
                  ],
                  "properties": {
                    "kind": {
                      "const": "runtimeComponent"
                    },
                    "componentDescriptorPath": {
                      "$ref": "#/$defs/componentDescriptorPath"
                    },
                    "purpose": {
                      "$ref": "#/$defs/purpose"
                    },
                    "required": {
                      "$ref": "#/$defs/required"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "pipName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "description": "PyPI distribution name; extras, ranges, URLs, paths and VCS references are rejected."
    },
    "pipVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.*+!_-]{0,127}$",
      "description": "One exact PEP 440 version tail ([A-Za-z0-9.*+!_-]*, epoch/local markers verbatim, no operators/ranges)."
    },
    "aptName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9+._-]{0,127}$",
      "description": "Debian source package identity."
    },
    "aptVersion": {
      "type": "string",
      "pattern": "^(?:[0-9]+:)?[A-Za-z0-9][A-Za-z0-9+~:.+-]{0,127}$",
      "description": "Exact Debian version, epoch preserved; +dfsg/-rev/+tilde/repack suffixes stay part of the pin."
    },
    "fontVersion": {
      "type": "string",
      "pattern": "^(?:[0-9]+:)?[A-Za-z0-9][A-Za-z0-9+~:.+-]{0,127}$",
      "description": "Same exact Debian version class as the apt kind."
    },
    "npmName": {
      "type": "string",
      "pattern": "^(?:@[a-z0-9-~][a-z0-9-._~]{0,63}/)?[a-z0-9-~][a-z0-9-._~]{0,127}$",
      "description": "npm name, optionally @scope/ scoped."
    },
    "npmVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
      "description": "Exact semver X.Y.Z with optional prerelease tail; '+' build metadata is rejected, matching the native decoder."
    },
    "fontIdentity": {
      "type": "string",
      "pattern": "^fonts-[a-z0-9][a-z0-9+._-]{0,127}$",
      "description": "Exactly one Debian font package identity (fonts- prefix)."
    },
    "lockfile": {
      "type": "string",
      "pattern": "^references/[A-Za-z0-9._/-]{1,255}\\.txt$",
      "not": {
        "pattern": "\\.\\."
      },
      "description": "Package-local lock reference (pip kind only). Its bytes are covered by the package contentDigest."
    },
    "componentDescriptorPath": {
      "const": "references/engine-dependency.json",
      "description": "The frozen runtime-component descriptor path; identity/version/digest come only from the pinned descriptor through the existing managed allowlist (today exactly impeccable-engine)."
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "1-200 bytes of model-safe text; no leading/trailing whitespace and no control characters (native decoder rules beyond this document)."
    },
    "required": {
      "type": "boolean",
      "description": "true gates that skill's dependency-aware exec.shell invocation until the requirement is verified ready."
    }
  }
}
