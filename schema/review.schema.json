{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JiangNanGenius/floe-skill-hub/schema/review.schema.json",
  "title": "Signed publisher review record (reviews/{id}/{version}.review.json)",
  "description": "Canonical bytes, each record additionally signed with a catalog.sig-shaped .review.json.sig envelope. Binds ID/version to the exact content it vouched for; package or digest changes invalidate it. Review records bind the existing grant model — they are not a second permission database and cannot be self-issued by a package, README or model parameter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "contentDigest",
    "packageSha256",
    "reviewedCapabilities",
    "reviewedTools",
    "reviewedPythonPackages",
    "execution",
    "reviewStage",
    "reviewedAt",
    "reviewer",
    "decision",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "packageSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewedCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "workspace.read",
          "workspace.write",
          "workspace.delete",
          "network",
          "browser.observe",
          "browser.interact",
          "credentials",
          "javascript.local",
          "python.local",
          "execution.remote"
        ]
      }
    },
    "reviewedTools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)+$"
      }
    },
    "reviewedPythonPackages": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "spec",
          "purpose",
          "capabilities"
        ],
        "properties": {
          "spec": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*==[A-Za-z0-9][A-Za-z0-9._+!-]*$",
            "description": "exact PyPI name==version; ranges/URLs/VCS are rejected"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "arch",
        "evidence"
      ],
      "properties": {
        "os": {
          "enum": [
            "linux",
            "macos",
            "ios",
            null
          ]
        },
        "arch": {
          "enum": [
            "riscv64",
            "x86_64",
            "aarch64",
            "n/a",
            null
          ]
        },
        "evidence": {
          "enum": [
            "unproven",
            "guest-verified"
          ]
        }
      },
      "description": "Execution OS/architecture, separate from store/install channels. unproven is the only value a candidate may carry."
    },
    "reviewStage": {
      "enum": [
        "static-content-reviewed",
        "guest-execution-qualified"
      ]
    },
    "reviewedAt": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "decision": {
      "enum": [
        "approve",
        "reject"
      ]
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh-Hans"
      ],
      "properties": {
        "en": {
          "type": "string"
        },
        "zh-Hans": {
          "type": "string"
        }
      }
    }
  }
}
