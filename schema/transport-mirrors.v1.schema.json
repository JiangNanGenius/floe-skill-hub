{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Floe GitHub transport mirror list v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "purpose",
    "generation",
    "issuedAt",
    "expiresAt",
    "roles"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "purpose": {
      "const": "floe-github-transport-mirrors"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issuedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expiresAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawFiles",
        "atom",
        "releaseAssets"
      ],
      "properties": {
        "rawFiles": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ghfast.top",
              "gh-proxy.com"
            ]
          }
        },
        "atom": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ghfast.top",
              "gh-proxy.com"
            ]
          }
        },
        "releaseAssets": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ghfast.top",
              "gh-proxy.com"
            ]
          }
        }
      }
    }
  },
  "$comment": "Authoritative verifier also requires canonical ASCII sorted compact JSON plus one LF, domain-separated signature before field trust, exact integer types, real UTC calendar timestamps, <=300 seconds future skew, positive <=30-day validity and strictly monotonic generation. JSON Schema alone is not trust."
}
