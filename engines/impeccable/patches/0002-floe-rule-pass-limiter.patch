+    /// One cooperative check: a recorded trip wins, else cancel, else the
+    /// deadline. The first trip sticks until [`Self::take_pass_trip`].
+    pub fn cooperative_trip(&self) -> Option<PassTrip> {
+        if let Some(t) = self.trip.get() {
+            return Some(t);
+        }
+        let limiter = self.limiter.borrow();
+        let limiter = limiter.as_ref()?;
+        if limiter.cancelled() {
+            self.trip.set(Some(PassTrip::Cancelled));
+        } else if limiter.deadline_exceeded() {
+            self.trip.set(Some(PassTrip::Deadline));
+        }
+        self.trip.get()
+    }
+
