{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floe.skillhub.dev/showcase/links.schema.json",
  "title": "Floe Skill Hub showcase links.json (frozen v1)",
  "description": "Evidence-backed cross-skill reference audits. Not an installer dependency manifest: no automatic fetch/install, no permission inheritance. See showcase/CONTRACT.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "entries": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/skillId"},
      "additionalProperties": {"$ref": "#/$defs/audit"}
    }
  },
  "$defs": {
    "skillId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Existing catalog registry id."
    },
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh-Hans"],
      "properties": {
        "en": {"type": "string", "minLength": 1, "maxLength": 4000},
        "zh-Hans": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": {"const": "hub"},
            "id": {"$ref": "#/$defs/skillId"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "label", "url"],
          "properties": {
            "kind": {"const": "external-skill"},
            "label": {"$ref": "#/$defs/bilingual"},
            "url": {
              "type": "string",
              "pattern": "^https://github.com/",
              "description": "HTTPS GitHub source URL with an explicit pinned 40-hex commit where available. Visibly unlisted/unreviewed reference; never auto-fetched or installed."
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "sha256", "lineStart", "lineEnd"],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "description": "Strict relative source file in this repository."
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "lineStart": {"type": "integer", "minimum": 1},
          "lineEnd": {"type": "integer", "minimum": 1}
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auditStatus", "links"],
      "properties": {
        "auditStatus": {"enum": ["audited", "pending"]},
        "links": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/link"}}
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "target", "evidence"],
      "properties": {
        "relation": {"enum": ["references", "optional", "requires"]},
        "target": {"$ref": "#/$defs/target"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "notes": {"$ref": "#/$defs/bilingual"}
      }
    }
  }
}
